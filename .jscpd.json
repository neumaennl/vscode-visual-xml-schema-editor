{
  "path": ["."],
  "format": ["typescript", "javascript"],
  "ignore": ["**/shared/generated/**"],
  "ignorePattern": ["import (type )?\\{[^}]*\\} from \"[^\"]*\";"],
  "minTokens": 50,
  "minLines": 5,
  "ignoreIdentifiers": true,
  "ignoreLiterals": false,
  "exitCode": 1,
  "failOnEmpty": true,
  "reporters": ["console"],
  "noTips": true
}
