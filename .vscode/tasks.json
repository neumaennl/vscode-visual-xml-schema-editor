// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile-extension",
      "group": "build",
      "problemMatcher": "$tsc",
      "label": "npm: compile-extension",
      "detail": "tsc -p ./tsconfig.extension.json"
    },
    {
      "type": "npm",
      "script": "compile-webview",
      "group": "build",
      "label": "npm: compile-webview"
    },
    {
      "label": "Build All",
      "dependsOn": [
        "npm: compile-extension",
        "npm: compile-webview"
      ],
      "dependsOrder": "parallel",
      "group": "build"
    },
    {
      "type": "npm",
      "script": "watch-extension",
      "group": "build",
      "problemMatcher": "$tsc-watch",
      "label": "npm: watch-extension",
      "isBackground": true
    },
    {
      "type": "npm",
      "script": "watch-webview",
      "group": "build",
      "label": "npm: watch-webview",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^\\[(.+?)\\] (.*)$",
            "code": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*╭─\\[ (.+):(\\d+):(\\d+) \\]$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build started\\.\\.\\.$",
          "endsPattern": "^(built in \\d+ms\\.|Build failed with)"
        }
      }
    },
    {
      "label": "Watch All",
      "dependsOn": [
        "npm: watch-extension",
        "npm: watch-webview"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}