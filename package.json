{
  "type": "module",
  "name": "xml-schema-visual-editor",
  "displayName": "XML Schema Visual Editor",
  "description": "Visual editor for XML schemas with diagram view",
  "icon": "icon.png",
  "version": "0.0.1",
  "publisher": "neumaennl",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/neumaennl/vscode-visual-xml-schema-editor.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "xsd",
    "xml schema",
    "xml",
    "schema",
    "diagram",
    "visualization"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "xmlSchemaVisualEditor.editor",
        "displayName": "XML Schema Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.xsd"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "xmlSchemaVisualEditor.openEditor",
        "title": "Open in XML Schema Visual Editor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .xsd",
          "command": "xmlSchemaVisualEditor.openEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "XML Schema Visual Editor",
      "properties": {
        "xmlSchemaVisualEditor.showDocumentation": {
          "type": "boolean",
          "default": false,
          "description": "Show documentation annotations in the diagram"
        },
        "xmlSchemaVisualEditor.alwaysShowOccurrence": {
          "type": "boolean",
          "default": false,
          "description": "Always show occurrence constraints (minOccurs/maxOccurs) even for default values (1..1)"
        },
        "xmlSchemaVisualEditor.showType": {
          "type": "boolean",
          "default": false,
          "description": "Show type information for elements in the diagram"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "compile": "npm run compile-extension && npm run compile-webview",
    "compile-extension": "tsc -p ./tsconfig.extension.json",
    "compile-webview": "tsc --noEmit -p tsconfig.webview.json && vite build --mode production",
    "watch": "concurrently \"npm run watch-extension\" \"npm run watch-webview\"",
    "watch-extension": "tsc -watch -p ./tsconfig.extension.json",
    "watch-webview": "vite build --watch --mode development",
    "pretest": "npm run compile && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.extension-test.json && tsc --noEmit -p tsconfig.webview-test.json && tsc --noEmit -p tsconfig.shared-test.json && tsc --noEmit -p tsconfig.nodeTools.json && tsc --noEmit -p tsconfig.extension-host-test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:extension-host": "npm run compile-extension && npm run stage:extension-host",
    "stage:extension-host": "rimraf .vscode-test/out && tsc -p tsconfig.extension-host-test.json && node scripts/stage-extension-host-test.ts",
    "test:extension-host": "vscode-test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "vsce package",
    "package:verify": "node scripts/verify-vsix.ts",
    "vscode:check": "node scripts/vscode-version.ts check",
    "vscode:update": "node scripts/vscode-version.ts update",
    "clean": "rimraf out webview",
    "generate-classes-from-schema": "xsd2ts --force -i schema/XMLSchema.xsd -o shared/generated"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.13.0",
    "@types/vscode": "~1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@neumaennl/xmlbind-ts": "^2.3.0",
    "@vscode/codicons": "^0.0.45"
  }
}
