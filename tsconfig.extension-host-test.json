{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2024",
    "rootDir": "test/extension-host",
    "outDir": ".vscode-test/out",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "sourceMap": true,
    "types": [
      "mocha",
      "node",
      "vscode"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "test/extension-host/**/*.ts"
  ]
}
