{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "sourceMap": true,
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "webview-src/**/*",
    "shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "out",
    "webview",
    "**/*.test.ts",
    "**/*.test-d.ts",
    "**/__tests__/**"
  ]
}